CHATWOOT_URL=https://chatwoot.odontotec.easypanel.host
CHATWOOT_API_TOKEN=xxx
CHATWOOT_ACCOUNT_ID=1
BOT_OFF_LABEL=bot-off

CALCOM_URL=https://calcom.odontotec.easypanel.host
CALCOM_API_KEY=xxx
CALCOM_EVENTS={"general":6008308,"ortodoncia":6008309,"endodoncia":6008310,"cirugia":6008311,"protesis":6008312,"odontopediatria":6008313}

# OpenRouter (preferido) O OpenAI directo — solo uno es necesario
OPENROUTER_API_KEY=xxx
# OPENAI_API_KEY=xxx
OPENAI_MODEL=openai/gpt-4o-mini

# Email confirmaciones de citas
# Gmail: activar "App Passwords" en cuenta Google → usar como SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=odontotec@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=Odontotec <odontotec@gmail.com>
EMAIL_CLINIC=contactoodontotec@gmail.com

PORT=8000
MAX_HISTORY=20
# Token compartido del webhook: generar uno aleatorio (ej. openssl rand -hex 24) y ponerlo
# TAMBIÉN en la URL del webhook en Chatwoot: https://<host>/webhook?token=ESE_TOKEN
# Vacío = webhook abierto (solo mientras se configura; queda warning en logs).
WEBHOOK_SECRET=
TIMEZONE=America/Santo_Domingo
REMINDER_HOUR=20

# --- Recordatorios WhatsApp (plantilla Cloud API vía Chatwoot) ---
# Inbox WhatsApp de Chatwoot (Settings → Inboxes → el ID va en la URL).
CHATWOOT_INBOX_ID=
# Plantilla APROBADA en Meta (nombre exacto), idioma y categoría.
WA_TEMPLATE_NAME=confirmacion_cita
WA_TEMPLATE_LANG=es
WA_TEMPLATE_CATEGORY=UTILITY
# Código de país para normalizar teléfonos locales de Dentidesk a E.164 (Rep. Dom. = 1).
WA_COUNTRY_CODE=1

# --- Dentidesk (agenda real) ---
# API (cuenta de servicio del proveedor CERO.AI) — solo LECTURA hasta la simulación
DENTIDESK_BASE=https://app.dentidesk.com/api
DENTIDESK_USER=produccion@cero.ai
DENTIDESK_PASS=
DENTIDESK_LOCATION=214
# Login web (cuenta staff) — solo para Playwright (crear/mover citas)
DENTIDESK_WEB_USER=h.geronimo
DENTIDESK_WEB_PASS=
# CANDADO de escritura: dejar VACÍO/0 en prod. Solo =1 en el campo de simulación autorizado.
DENTIDESK_ALLOW_WRITES=
# DENTIDESK_PW_HEADLESS=1   # navegador Playwright sin ventana (default)
# Mapa especialidad→doctor para #dentista_cita (JSON, coincidencia flexible por fragmento de
# nombre). Sobreescribe los defaults de agent/tool_handlers.py. "general" va con "" (vacío):
# regla del cliente — odontología general es personal fijo, la cita NO se registra por doctor
# (no se toca el select). Ej:
# DENTIDESK_DOCTOR_MAP={"ortodoncia":"Casado","protesis":"Lora"}

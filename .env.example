CHATWOOT_URL=https://chatwoot.odontotec.easypanel.host
CHATWOOT_API_TOKEN=xxx
CHATWOOT_ACCOUNT_ID=1
BOT_OFF_LABEL=bot-off

CALCOM_URL=https://calcom.odontotec.easypanel.host
CALCOM_API_KEY=xxx
CALCOM_EVENTS={"general":6008308,"ortodoncia":6008309,"endodoncia":6008310,"cirugia":6008311,"protesis":6008312,"odontopediatria":6008313}

# OpenRouter (preferido) O OpenAI directo — solo uno es necesario
OPENROUTER_API_KEY=xxx
# OPENAI_API_KEY=xxx
OPENAI_MODEL=openai/gpt-4o-mini

# Servidor de correo de la app (hoy lo usa el watchdog para avisarle al operador).
# Gmail: activar 2FA y crear una "App Password" (16 letras) → va en SMTP_PASS. La contraseña
# normal de Gmail NO funciona por SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=odontotec@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=Odontotec <odontotec@gmail.com>
EMAIL_CLINIC=contactoodontotec@gmail.com

PORT=8000
MAX_HISTORY=20
# Token compartido del webhook: generar uno aleatorio (ej. openssl rand -hex 24) y ponerlo
# TAMBIÉN en la URL del webhook en Chatwoot: https://<host>/webhook?token=ESE_TOKEN
# Vacío = webhook abierto (solo mientras se configura; queda warning en logs).
WEBHOOK_SECRET=
TIMEZONE=America/Santo_Domingo
REMINDER_HOUR=20

# --- Recordatorios WhatsApp (plantilla Cloud API vía Chatwoot) ---
# Inbox WhatsApp de Chatwoot (Settings → Inboxes → el ID va en la URL).
CHATWOOT_INBOX_ID=
# Plantilla APROBADA en Meta (nombre exacto), idioma y categoría.
WA_TEMPLATE_NAME=confirmacion_cita
WA_TEMPLATE_LANG=es
WA_TEMPLATE_CATEGORY=UTILITY
# Código de país para normalizar teléfonos locales de Dentidesk a E.164 (Rep. Dom. = 1).
WA_COUNTRY_CODE=1

# --- Watchdog: vigila daemon Dentidesk + LLM y avisa al OPERADOR ---
# Existe porque el 2026-07-15 Chrome se murió dentro del daemon y el sistema pasó un día entero
# con la agenda muerta, sin una línea en el log. Alerta solo en la transición sano→enfermo.
WATCHDOG_INTERVAL_MIN=5
# Canal EMAIL — funciona ya, solo necesita las SMTP_* de arriba.
WATCHDOG_ALERT_EMAIL=fondeur28@gmail.com
# Canal WHATSAPP — inactivo hasta que existan las dos cosas: un inbox de Chatwoot DEDICADO (NO
# CHATWOOT_INBOX_ID, que es el número de Carla con pacientes) y la plantilla aprobada en Meta.
# Vacío = se salta el canal y solo manda el email. Ver docs/watchdog-alertas-plan-fase2-migracion-numero.md
WATCHDOG_ALERT_TO_NUMBER=+18099790205
WATCHDOG_ALERT_INBOX_ID=
WATCHDOG_ALERT_TEMPLATE_NAME=alerta_operativa
# Umbrales por ciclo: cuántas anomalías del agente disparan aviso.
WATCHDOG_ESCALATE_BLOCKED_THRESHOLD=5
WATCHDOG_ITERATIONS_EXHAUSTED_THRESHOLD=2
WATCHDOG_AGENT_FAILED_THRESHOLD=3

# --- Dentidesk (agenda real) ---
# API (cuenta de servicio del proveedor CERO.AI) — solo LECTURA hasta la simulación
DENTIDESK_BASE=https://app.dentidesk.com/api
DENTIDESK_USER=produccion@cero.ai
DENTIDESK_PASS=
DENTIDESK_LOCATION=214
# Login web (cuenta staff) — solo para Playwright (crear/mover citas)
DENTIDESK_WEB_USER=h.geronimo
DENTIDESK_WEB_PASS=
# CANDADO de escritura: dejar VACÍO/0 en prod. Solo =1 en el campo de simulación autorizado.
DENTIDESK_ALLOW_WRITES=
# DENTIDESK_PW_HEADLESS=1   # navegador Playwright sin ventana (default)
# Mapa especialidad→doctor para #dentista_cita (JSON, coincidencia flexible por fragmento de
# nombre). Sobreescribe los defaults de agent/tool_handlers.py. "general" va con "" (vacío):
# regla del cliente — odontología general es personal fijo, la cita NO se registra por doctor
# (no se toca el select). Ej:
# DENTIDESK_DOCTOR_MAP={"ortodoncia":"Casado","protesis":"Lora"}

# --- Dentidesk: navegador persistente para escrituras (ver dentidesk-pendiente-daemon-produccion) ---
# Servicio "odontotec" (agente) — habla por HTTP a la API interna del contenedor "daemon" en vez
# de tocar Playwright/CDP directo. Con esto seteado, DENTIDESK_ALLOW_WRITES sigue siendo el
# candado real (create_appointment/move_appointment lo exigen antes de llamar al daemon).
# DENTIDESK_DAEMON_URL=http://dentidesk-daemon:8100   # nombre interno del servicio en EasyPanel
# DENTIDESK_DAEMON_SECRET=                            # mismo valor en ambos servicios

# Servicio "dentidesk-daemon" (contenedor nuevo, build --target daemon) — SOLO estas envs, no las
# de arriba salvo WEB_USER/PASS y ALLOW_WRITES (el daemon también valida el candado):
# DENTIDESK_WEB_USER=carlaodontotec@odontotec.com.do
# DENTIDESK_WEB_PASS=
# DENTIDESK_ALLOW_WRITES=1
# DENTIDESK_DAEMON_SECRET=            # igual al de arriba
# DENTIDESK_PROFILE_DIR=/data/dd_profile   # volumen persistente, si no se pierde el login en cada redeploy
# DAEMON_VNC_PASSWORD=                 # obligatorio: sin esto el contenedor no arranca (ver daemon_entrypoint.sh)
